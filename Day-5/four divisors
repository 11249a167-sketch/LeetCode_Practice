class Solution {
public:
    int sumFourDivisors(vector<int>& nums) {

        int totalSum = 0;

        for (int num : nums) {

            int count = 0;
            int sum = 0;

            for (int i = 1; i * i <= num; i++) {

                if (num % i == 0) {

                    int divisor1 = i;
                    int divisor2 = num / i;

                    count++;
                    sum += divisor1;

                    if (divisor1 != divisor2) {
                        count++;
                        sum += divisor2;
                    }

                    if (count > 4)
                        break;
                }
            }

            if (count == 4)
                totalSum += sum;
        }

        return totalSum;
    }
};
