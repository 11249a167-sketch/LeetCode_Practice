class Solution {
public:
    long long maxMatrixSum(vector<vector<int>>& matrix) {

        long long sum = 0;
        int negativeCount = 0;
        int minAbs = INT_MAX;

        for (auto& row : matrix) {
            for (int num : row) {

                sum += abs(num);

                if (num < 0)
                    negativeCount++;

                minAbs = min(minAbs, abs(num));
            }
        }

        if (negativeCount % 2 == 0)
            return sum;

        return sum - 2LL * minAbs;
    }
};
