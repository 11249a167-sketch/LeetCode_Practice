class Solution {
public:
    int earliestFinishTime(vector<int>& landStartTime,
                           vector<int>& landDuration,
                           vector<int>& waterStartTime,
                           vector<int>& waterDuration) {

        long long ans = LLONG_MAX;

        int n = waterStartTime.size();

        vector<pair<int,int>> water;
        for (int i = 0; i < n; i++) {
            water.push_back({waterStartTime[i], waterDuration[i]});
        }

        sort(water.begin(), water.end());

        vector<long long> prefMinDur(n);
        vector<long long> suffMinFinish(n);

        prefMinDur[0] = water[0].second;
        for (int i = 1; i < n; i++) {
            prefMinDur[i] = min(prefMinDur[i - 1],
                                (long long)water[i].second);
        }

        suffMinFinish[n - 1] =
            (long long)water[n - 1].first + water[n - 1].second;

        for (int i = n - 2; i >= 0; i--) {
            suffMinFinish[i] = min(
                suffMinFinish[i + 1],
                (long long)water[i].first + water[i].second
            );
        }

        for (int i = 0; i < landStartTime.size(); i++) {

            long long landFinish =
                (long long)landStartTime[i] + landDuration[i];

            int pos = upper_bound(
                water.begin(),
                water.end(),
                make_pair((int)landFinish, INT_MAX)
            ) - water.begin();

            if (pos > 0) {
                ans = min(ans,
                          landFinish + prefMinDur[pos - 1]);
            }

            if (pos < n) {
                ans = min(ans,
                          suffMinFinish[pos]);
            }
        }

        int m = landStartTime.size();

        vector<pair<int,int>> land;
        for (int i = 0; i < m; i++) {
            land.push_back({landStartTime[i], landDuration[i]});
        }

        sort(land.begin(), land.end());

        vector<long long> prefMinDur2(m);
        vector<long long> suffMinFinish2(m);

        prefMinDur2[0] = land[0].second;
        for (int i = 1; i < m; i++) {
            prefMinDur2[i] = min(prefMinDur2[i - 1],
                                 (long long)land[i].second);
        }

        suffMinFinish2[m - 1] =
            (long long)land[m - 1].first + land[m - 1].second;

        for (int i = m - 2; i >= 0; i--) {
            suffMinFinish2[i] = min(
                suffMinFinish2[i + 1],
                (long long)land[i].first + land[i].second
            );
        }

        for (int i = 0; i < waterStartTime.size(); i++) {

            long long waterFinish =
                (long long)waterStartTime[i] + waterDuration[i];

            int pos = upper_bound(
                land.begin(),
                land.end(),
                make_pair((int)waterFinish, INT_MAX)
            ) - land.begin();

            if (pos > 0) {
                ans = min(ans,
                          waterFinish + prefMinDur2[pos - 1]);
            }

            if (pos < m) {
                ans = min(ans,
                          suffMinFinish2[pos]);
            }
        }

        return (int)ans;
    }
};
